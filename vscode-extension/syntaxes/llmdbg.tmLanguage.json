{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "llmdbg",
  "scopeName": "source.llmdbg",
  "patterns": [
    { "include": "#comments" },
    { "include": "#functions" },
    { "include": "#keys" },
    { "include": "#strings" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.llmdbg", "match": "#.*$" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "meta.function.llmdbg", "match": "^(def)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\(\\))(:)", "captures": { "1": { "name": "storage.type.function.llmdbg" }, "2": { "name": "entity.name.function.llmdbg" }, "3": { "name": "punctuation.definition.parameters.llmdbg" }, "4": { "name": "punctuation.section.block.begin.llmdbg" } } },
        { "name": "support.function.model-operation.llmdbg", "match": "^\\s+(?:layernorm|qkv_projection|attention_mixing|output_projection|expansion|gelu|projection|residual_add)\\s*$" },
        { "name": "support.function.model-call.llmdbg", "match": "^(?:attention|mlp)(?=\\(\\))" }
      ]
    },
    "keys": {
      "patterns": [
        { "name": "variable.other.key.llmdbg", "match": "^[A-Za-z_][A-Za-z0-9_-]*(?=\\s*=)" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.llmdbg", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.llmdbg", "match": "\\\\." }] }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.llmdbg", "match": "\\b(?:true|false)\\b" },
        { "name": "constant.numeric.llmdbg", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b" }
      ]
    }
  }
}

{
  "name": "llmdbg",
  "displayName": "llmdbg",
  "description": "Step through LLM layers and inspect human-readable internal representations.",
  "version": "0.0.4",
  "publisher": "liusida",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liusida/llmdbg.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Machine Learning"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug"
  ],
  "files": [
    "extension.js",
    "bundled/**",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "contributes": {
    "debuggers": [
      {
        "type": "llmdbg",
        "label": "llmdbg",
        "languages": [
          "python"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop after the first model layer.",
                "default": true
              },
              "model": {
                "type": "string",
                "description": "Hugging Face model ID or local model directory."
              },
              "revision": {
                "type": "string",
                "description": "Model repository branch, tag, or commit."
              },
              "prompt": {
                "type": "string",
                "description": "Input prompt for the model."
              },
              "device": {
                "type": "string",
                "enum": ["cuda", "cpu"],
                "default": "cuda"
              },
              "dtype": {
                "type": "string",
                "enum": ["bfloat16", "float16", "float32"],
                "default": "bfloat16"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "llmdbg",
            "request": "launch",
            "name": "llmdbg: Demo model",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "llmdbg: Demo model",
            "description": "Step through the built-in model layer by layer.",
            "body": {
              "type": "llmdbg",
              "request": "launch",
              "name": "llmdbg: Demo model",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "llmdbg",
      "properties": {
        "llmdbg.bootstrapPythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable used only to create llmdbg's private environment. Empty uses python3 (python on Windows)."
        }
      }
    }
  },
  "scripts": {
    "stage-adapter": "node ./scripts/stage-adapter.js",
    "package": "npm run stage-adapter && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
